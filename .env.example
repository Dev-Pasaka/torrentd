# Copy to .env and edit. Every value is optional.

# Login. Leave both blank to get a generated password in the container logs.
TORRENTD_USER=admin
TORRENTD_PASS=

# Where the files land on the host, and where the SQLite database lives.
# Relative paths are resolved against the compose file's directory; absolute
# paths work too. No shell runs on these, so spaces and & need no escaping:
#   DOWNLOADS_DIR=/srv/jellyfin/media/Shows&Movies
DOWNLOADS_DIR=./downloads
DATA_DIR=./data

# Host port for the web UI (still bound to 127.0.0.1 by the compose file).
WEB_PORT=8080

# BitTorrent peer port and DHT port. BT_PORT is published on TCP *and* UDP
# (uTP); DHT is UDP only and must be a different number — WebTorrent binds them
# separately. Forward them on your router.
BT_PORT=6881
DHT_PORT=6882

# Own the downloaded files as this user. Match your host account with
# `id -u` and `id -g` if files come out owned by the wrong user.
PUID=1000
PGID=1000

# Set either to 1 to let the client open its port on your router automatically.
# Off by default — see the security notes in the README.
NAT_UPNP=
NAT_PMP=

# Powers the "Browse" search tab (movie/show lookup + Jellyfin-style name
# generator). Use the "API Read Access Token" (v4 auth, a long JWT) from
# https://www.themoviedb.org/settings/api — not the shorter v3 API key. Leave
# blank to disable the tab — everything else still works without it.
TMDB_API_KEY=

# Torrent search on a title's page, via the moviesapi service (see
# ./moviesapi). Default points at that service's container name on the
# compose-internal network — only change this if moviesapi runs elsewhere.
MOVIESAPI_URL=http://moviesapi:8000

# Named roots the Files page (browse/delete/copy/move) is allowed to touch —
# comma-separated Name:/container/path pairs. Each name here needs a matching
# volume mount in docker-compose.yml; this is intentionally not a free-text
# host path; only what you explicitly mount and list here is reachable.
#   LIBRARY_DIRS=Downloads:/downloads,Movies:/media/movies,Shows:/media/shows
LIBRARY_DIRS=Downloads:/downloads
